---
const SECTIONS = [
    { id: "inicio", label: "Inicio" },
    { id: "about", label: "Sobre mi" },
    { id: "projects", label: "Mis libros" },
    { id: "contact", label: "Contacto" },
];
---

<nav
    id="navbar"
    class="sticky top-0 bg-white/0 z-50 flex justify-between items-end px-6 pt-4"
>
    <div
        class="text-2xl font-serif font-semibold tracking-tighter cursor-pointer"
    >
        <a href="#inicio">MR.</a>
    </div>
    <div id="navbar-sections" class="flex flex-row gap-5">
        {SECTIONS.map((s) => <a class="cursor-pointer" href={`#${s.id}`}>{s.label}</a>)}
    </div>
</nav>

